# ---------------------------------------------------------------------------
# AMZ environment template. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored; only this template is committed.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=amz
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=amz

# Backend uses this SQLAlchemy URL. Host MUST be the compose service name `database`.
DATABASE_URL=postgresql+psycopg://amz:change_me_strong_password@database:5432/amz

# --- Redis / Celery ---
# Host MUST be the compose service name `redis`.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Anthropic AI ranking ---
# Get a key at https://console.anthropic.com/. If left blank, AMZ still runs and
# falls back to a deterministic heuristic scorer (clearly labeled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Recon safety guardrails ---
# Max subdomains probed per scan (protects both you and the target).
RECON_MAX_HOSTS=150
# Concurrent HTTP probes.
RECON_CONCURRENCY=20
# Per-request timeout (seconds).
RECON_TIMEOUT=8
# Minimum seconds between scans per user (server-side rate limit).
SCAN_MIN_INTERVAL_SECONDS=30

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:3000
